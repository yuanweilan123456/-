{
  "name": "filetools-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.8.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "postbuild": "tsx scripts/prerender.ts",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run src",
    "test:e2e": "playwright test",
    "test": "npm run test:unit",
    "verify:dist": "tsx scripts/verify-prerender.ts",
    "submit:indexnow": "node scripts/submit-indexnow.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run verify:dist"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "docx-preview": "^0.4.1",
    "html2canvas-pro": "^2.4.4",
    "jszip": "^3.10.1",
    "mammoth": "^1.9.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.624",
    "vue": "^3.5.13",
    "vue-i18n": "^11.1.2",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^15.15.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.0"
  }
}
